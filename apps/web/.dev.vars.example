# ローカル専用の VAPID 鍵ペアを scripts/generate-vapid-keys.ts で生成し、
# apps/scheduler/.dev.vars にも同じ3項目を設定する。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# 必須。空だと pnpm dev がどのページも 500 になる（docs/design-decisions.md 参照）。
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" で生成
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
