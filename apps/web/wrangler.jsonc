{
	"name": "ebb-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"vars": {
		"VAPID_PUBLIC_KEY": "BFknaCFpg1G3yB8-5zuBGvgxe4C0yh_4qT1-JNV5sapFB8IOTuc6dacHDSRbZyOHAAGqEpKqMkx6AedzUeBvB4I",
		"VAPID_SUBJECT": "mailto:tomoki-chiba@gaji.jp"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "ebb.tom-chiba.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ebb",
			"database_id": "9d613b4c-3fa7-454d-a7d9-0c0930eb7b40",
			"migrations_dir": "../../packages/db/migrations"
		}
	]
}
