{
	"name": "@ebb/scheduler",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --test-scheduled",
		"check": "tsc --noEmit",
		"cf-typegen": "test -f .dev.vars || cp .dev.vars.example .dev.vars && wrangler types --include-runtime=false",
		"migrate:local": "wrangler d1 migrations apply ebb --local",
		"deploy": "wrangler deploy",
		"test": "vitest run"
	},
	"dependencies": {
		"@ebb/db": "workspace:*",
		"@ebb/push": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@cloudflare/workers-types": "^4.20260702.1",
		"typescript": "catalog:",
		"vitest": "^4.1.0",
		"wrangler": "^4.118.0"
	}
}
