{
	// vitest-pool-workers 専用の設定。apps/web/wrangler.test.jsonc と同じ理由
	// （本番用 wrangler.jsonc は VAPID の実値や cron 設定を含み、テストには不要）で切り出す。
	"name": "ebb-scheduler-test",
	// apps/web/wrangler.test.jsonc と同じ値（vitest-pool-workers@0.18.8 に同梱の workerd が対応する
