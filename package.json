{
	"name": "ebb",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.18.1 <25.0.0"
	},
	"scripts": {
		"dev": "pnpm -r --parallel --if-present run dev",
		"build": "pnpm -r --if-present run build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present run test",
		"check": "tsc -p . && pnpm -r --if-present run check",
		"db:generate": "pnpm --filter @ebb/db run generate",
		"db:migrate:local": "pnpm --filter @ebb/web --filter @ebb/scheduler run migrate:local",
		"db:migrate:remote": "pnpm --filter @ebb/web run migrate:remote"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.19.0",
		"@types/node": "^24.0.0",
		"eslint": "^9.19.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.0.2",
		"globals": "^15.14.0",
		"jiti": "^2.4.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"typescript": "catalog:",
		"typescript-eslint": "^8.65.0"
	}
}
